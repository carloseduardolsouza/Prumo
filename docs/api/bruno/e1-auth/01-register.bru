meta {
  name: Registrar
  type: http
  seq: 1
}

post {
  url: {{baseUrlCore}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  { "name": "Carlos Souza", "email": "carlos@prumo.test", "password": "senha-segura-123", "deviceName": "Bruno" }
}

script:post-response {
  if (res.body.accessToken) bru.setEnvVar("token", res.body.accessToken);
  if (res.body.refreshToken) bru.setEnvVar("refreshToken", res.body.refreshToken);
}

assert {
  res.status: eq 201
}
