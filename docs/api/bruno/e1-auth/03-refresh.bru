meta {
  name: Refresh (rotativo)
  type: http
  seq: 3
}

post {
  url: {{baseUrlCore}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  { "refreshToken": "{{refreshToken}}" }
}

script:post-response {
  bru.setEnvVar("token", res.body.accessToken);
  bru.setEnvVar("refreshToken", res.body.refreshToken);
}

assert {
  res.status: eq 200
}
