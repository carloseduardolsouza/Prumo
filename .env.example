# Copie para .env e preencha. NUNCA versione o .env.

NODE_ENV=development
PORT_CORE=3000
PORT_MESSAGE=3001

# ── PostgreSQL ────────────────────────────────────────────────
# Se usar `docker compose up -d`, o container é criado com ESTAS credenciais.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=prumo
DB_SCHEMA=public
# Usado só pelo Prisma CLI (migrate/studio). O app monta a URL a partir das variáveis DB_* acima.
# Se a senha tiver caracteres especiais (@ : / # %), codifique-os aqui (ex.: @ vira %40).
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"

# ── Redis (fila BullMQ entre core e message) ──────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Segredos (mín. 16 caracteres; gere com: openssl rand -hex 32) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d
# Chave que o core e o message usam nas chamadas internas (header x-api-key)
INTERNAL_API_KEY=

# ── URLs ───────────────────────────────────────────────────────
CORE_URL=http://localhost:3000
MESSAGE_URL=http://localhost:3001
APP_URL=

# ── E-mail (em dev, o Mailpit do docker-compose: UI em http://localhost:8025) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Prumo <no-reply@prumo.local>"

# ── Push (Expo) ────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# Jobs periódicos do core (recorrências e lembretes)
JOBS_ENABLED=true
